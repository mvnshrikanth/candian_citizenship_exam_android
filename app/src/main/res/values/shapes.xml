<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The design's recurring "white card with a 1dp warm border, no shadow". -->
    <style name="Card.Bordered" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLowest</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">@dimen/stroke_card</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">@dimen/radius_md</item>
    </style>

    <style name="ShapeAppearance.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_pill</item>
    </style>
    <style name="ShapeAppearance.Xl" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_xl</item>
    </style>
    <style name="ShapeAppearance.Lg" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_lg</item>
    </style>
    <style name="ShapeAppearance.Md" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_md</item>
    </style>
    <style name="ShapeAppearance.Sm" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_sm</item>
    </style>
    <style name="ShapeAppearance.Xs" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_xs</item>
    </style>
    <style name="ShapeAppearance.Badge" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_badge</item>
    </style>
</resources>
