    <string name="ob_title_3">How this works</string>
    <string name="ob_step1_title">Practise a little, daily</string>
    <string name="ob_step1_body">Ten minutes beats an hour on Sunday. Your goal and streak are there to make the habit visible, nothing more.</string>
    <string name="ob_step2_title">Missed questions come back</string>
    <string name="ob_step2_body">Anything you get wrong twice joins your weak list and returns more often until it sticks.</string>
    <string name="ob_step3_title">Mock test when you\'re ready</string>
    <string name="ob_step3_body">Twenty questions, thirty minutes, fifteen to pass — the same shape as the real test.</string>
