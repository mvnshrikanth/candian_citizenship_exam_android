<?xml version="1.0" encoding="utf-8"?>
<!-- Typography from the Quiet Card spec. Weight rides the variable font's wght axis.
     parent="" on every style: dotted names would otherwise inherit implicitly. -->
<resources>
    <style name="Text.Display.Hero" parent="">
        <item name="android:fontFamily">@font/roboto_serif</item>
        <item name="android:fontVariationSettings">"'wght' 600"</item>
        <item name="android:textSize">40sp</item>
        <item name="android:lineSpacingMultiplier">1.05</item>
        <item name="android:letterSpacing">-0.025</item>
        <item name="android:textColor">@color/md_on_surface</item>
    </style>
