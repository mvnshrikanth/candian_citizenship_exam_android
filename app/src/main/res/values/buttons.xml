<?xml version="1.0" encoding="utf-8"?>
<!-- The design uses one button shape throughout: a full-width pill. Only the fill
     changes with intent, so these differ by backgroundTint and text colour alone. -->
<resources>
    <style name="Button.Base" parent="Widget.Material3.Button">
        <item name="android:textAppearance">@style/Text.Cta</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="android:paddingTop">@dimen/cta_pad_v</item>
        <item name="android:paddingBottom">@dimen/cta_pad_v</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="elevation">0dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Button.Cta.Primary" parent="Button.Base">
        <item name="backgroundTint">@color/md_primary</item>
        <item name="android:textColor">@color/md_on_primary</item>
    </style>

    <style name="Button.Cta.Sage" parent="Button.Base">
        <item name="backgroundTint">@color/md_secondary</item>
        <item name="android:textColor">@color/md_on_secondary</item>
    </style>

    <style name="Button.Cta.Danger" parent="Button.Base">
        <item name="backgroundTint">@color/md_error</item>
        <item name="android:textColor">@color/md_on_error</item>
    </style>

    <!-- The design's quiet secondary action: a filled pill in the neutral container. -->
    <style name="Button.Cta.Neutral" parent="Button.Base">
        <item name="backgroundTint">@color/md_surface_container</item>
        <item name="android:textColor">@color/md_on_surface</item>
    </style>

    <style name="Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAppearance">@style/Text.Cta</item>
        <item name="android:textSize">14.5sp</item>
        <item name="android:textColor">@color/md_primary</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Button.Text.Danger" parent="Button.Text">
        <item name="android:textColor">@color/md_error</item>
    </style>

    <!-- Icon-only circular action, e.g. the home search and settings buttons. -->
    <style name="Button.IconCircle" parent="Widget.Material3.Button.IconButton">
        <item name="android:layout_width">@dimen/circle_action</item>
        <item name="android:layout_height">@dimen/circle_action</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">21dp</item>
        <item name="android:padding">0dp</item>
        <item name="elevation">0dp</item>
    </style>
</resources>
