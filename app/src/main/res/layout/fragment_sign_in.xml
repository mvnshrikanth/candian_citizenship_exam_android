<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="@dimen/screen_pad_h"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:padding="13dp"
            android:src="@drawable/ic_arrow_left"
            app:tint="@color/md_on_surface" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/screen_pad_h"
        android:paddingEnd="@dimen/screen_pad_h"
        android:paddingBottom="@dimen/screen_pad_bottom">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sign_in_title"
                style="@style/Text.Headline.Screen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sign_in_title" />

            <TextView
                style="@style/Text.Body.Loose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/sign_in_blurb"
                android:textColor="@color/md_on_surface_variant" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Bordered"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_section">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/pad_card">

                    <TextView
                        style="@style/Text.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sign_in_email" />

                    <EditText
                        android:id="@+id/email"
                        style="@style/Text.Option"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:autofillHints="emailAddress"
                        android:background="@null"
                        android:hint="@string/sign_in_email"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:minHeight="@dimen/touch_min"
                        android:textColorHint="@color/md_outline" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/stroke_card"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:background="?attr/colorOutlineVariant" />

                    <TextView
                        style="@style/Text.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sign_in_password" />

                    <EditText
                        android:id="@+id/password"
                        style="@style/Text.Option"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:autofillHints="password"
                        android:background="@null"
                        android:hint="@string/sign_in_password"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:minHeight="@dimen/touch_min"
                        android:textColorHint="@color/md_outline" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/error"
                style="@style/Text.Body.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/md_error"
                android:visibility="gone"
                tools:text="There is no account for that email address."
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/submit"
                style="@style/Button.Cta.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_section"
                android:text="@string/sign_in_cta" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toggle_mode"
                style="@style/Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/sign_in_create" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/forgot"
                style="@style/Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/md_on_surface_variant"
                android:text="@string/sign_in_forgot" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
