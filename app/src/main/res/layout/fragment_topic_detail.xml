<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <!-- App bar. Sits outside the scroll view so the title stays put. -->
    <LinearLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="@dimen/screen_pad_h"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:padding="13dp"
            android:src="@drawable/ic_arrow_left"
            app:tint="@color/md_on_surface" />

        <TextView
            android:id="@+id/topic_name"
            style="@style/Text.Title.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            tools:text="Rights &amp; Responsibilities" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_pad_h"
        android:paddingEnd="@dimen/screen_pad_h"
        android:paddingBottom="@dimen/screen_pad_bottom">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/topic_blurb"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/md_on_surface_variant"
                        tools:text="Rule of law, the Charter, the Oath" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/cat_total"
                                style="@style/Text.Stat.XL"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="43" />

                            <TextView
                                style="@style/Text.Meta.Small"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/topic_stat_questions" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/cat_done"
                                style="@style/Text.Stat.XL"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="2" />

                            <TextView
                                style="@style/Text.Meta.Small"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/topic_stat_practised" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/cat_accuracy"
                                style="@style/Text.Stat.XL"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/md_primary"
                                tools:text="60%" />

                            <TextView
                                style="@style/Text.Meta.Small"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/topic_accuracy_label" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.mvnsh.citizenship.ui.common.BarView
                        android:id="@+id/coverage_bar"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/bar_thin"
                        android:layout_marginTop="16dp"
                        app:barFillColor="@color/md_secondary"
                        app:barTrackColor="@color/md_outline_variant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/practise_cta"
                style="@style/Button.Cta.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_section"
                tools:text="Practise 20 questions" />

            <TextView
                style="@style/Text.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/topic_questions_label" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/questions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="4"
                tools:listitem="@layout/item_topic_question" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
