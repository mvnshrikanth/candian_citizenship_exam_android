<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clipToPadding="false"
    android:paddingStart="@dimen/screen_pad_h"
    android:paddingEnd="@dimen/screen_pad_h"
    android:paddingTop="@dimen/screen_pad_top"
    android:paddingBottom="@dimen/screen_pad_bottom">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header: greeting, day line, and the two round actions. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greeting"
                    style="@style/Text.Body.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Good morning" />

                <TextView
                    android:id="@+id/day_line"
                    style="@style/Text.Headline.Screen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    tools:text="Day 12 of studying" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/search_button"
                style="@style/Button.IconCircle"
                android:layout_marginStart="10dp"
                android:contentDescription="@string/cd_search"
                app:backgroundTint="@color/md_surface_container"
                app:icon="@drawable/ic_search"
                app:iconTint="@color/md_on_surface_variant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settings_button"
                style="@style/Button.IconCircle"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/cd_settings"
                app:backgroundTint="@color/md_primary_container"
                app:icon="@drawable/ic_settings"
                app:iconTint="@color/md_on_primary_container" />
        </LinearLayout>

        <!-- Today's goal -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/goal_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:cardCornerRadius="@dimen/radius_xl"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/pad_card_xl">

                <TextView
                    style="@style/Text.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_goal_title" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/goal_count"
                        style="@style/Text.Stat.L"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/md_on_primary_container"
                        tools:text="14" />

                    <TextView
                        android:id="@+id/goal_target"
                        style="@style/Text.Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/md_on_primary_container"
                        tools:text="/ 20 questions" />
                </LinearLayout>

                <com.mvnsh.citizenship.ui.common.BarView
                    android:id="@+id/goal_bar"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/bar_goal"
                    android:layout_marginTop="13dp"
                    app:barFillColor="@color/md_primary"
                    app:barTrackColor="@color/md_goal_track" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/goal_footer"
                        style="@style/Text.Meta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/md_on_primary_container"
                        tools:text="6 to go · about 3 minutes" />

                    <ImageView
                        android:id="@+id/streak_flame"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_flame"
                        app:tint="@color/md_on_primary_container" />

                    <TextView
                        android:id="@+id/streak_text"
                        style="@style/Text.Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontVariationSettings="'wght' 600"
                        android:textColor="@color/md_on_primary_container"
                        tools:text="12 days" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- The one big action. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/hero_cta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="?attr/colorPrimary"
            app:cardCornerRadius="@dimen/radius_xl"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="22dp"
                android:paddingTop="@dimen/pad_card_xl"
                android:paddingEnd="@dimen/pad_card_xl"
                android:paddingBottom="@dimen/pad_card_xl">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/hero_title"
                        style="@style/Text.Cta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/md_on_primary"
                        android:textSize="19sp"
                        tools:text="Start studying" />

                    <TextView
                        android:id="@+id/hero_sub"
                        style="@style/Text.Body.Small"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:alpha="0.85"
                        android:textColor="@color/md_on_primary"
                        tools:text="20 questions · about 10 minutes" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="@dimen/circle_action"
                    android:layout_height="@dimen/circle_action"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_cta_disc">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/md_on_primary" />
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Weak and mock, side by side. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/weak_tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="@dimen/radius_md"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/pad_card">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_warning"
                        app:tint="@color/md_on_surface_variant" />

                    <TextView
                        android:id="@+id/weak_count"
                        style="@style/Text.Stat.XL"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        tools:text="2" />

                    <TextView
                        style="@style/Text.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/home_weak" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mock_tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/gap_list_wide"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="?attr/colorSecondaryContainer"
                app:cardCornerRadius="@dimen/radius_md"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/pad_card">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_clock"
                        app:tint="@color/md_on_secondary_container" />

                    <TextView
                        style="@style/Text.Title.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/home_mock"
                        android:textColor="@color/md_on_secondary_container_strong"
                        android:textSize="15.5sp" />

                    <TextView
                        android:id="@+id/mock_sub"
                        style="@style/Text.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textColor="@color/md_on_secondary_container"
                        tools:text="20 questions · 30 min" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Countdown, shown only once a test date exists. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/countdown_card"
            style="@style/Card.Bordered"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/pad_card">

                <LinearLayout
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/days_left"
                        style="@style/Text.Stat.XL"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/md_primary"
                        tools:text="38" />

                    <TextView
                        style="@style/Text.Meta.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.07"
                        android:text="@string/home_days"
                        android:textAllCaps="true"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <View
                    android:layout_width="@dimen/stroke_card"
                    android:layout_height="34dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:background="?attr/colorOutlineVariant" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/test_on"
                        style="@style/Text.Title.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Test on 25 September 2026" />

                    <TextView
                        android:id="@+id/pace_line"
                        style="@style/Text.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        tools:text="On pace — 85% accuracy" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ...and the prompt that takes its place when there is none. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/no_date_card"
            style="@style/Card.Bordered"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/pad_card">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/md_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Title.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_add_date" />

                    <TextView
                        style="@style/Text.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/home_add_date_sub" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/md_outline" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Weakest topic, hidden until something has been practised. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/weakest_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="0dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/pad_card">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_weakest" />

                    <TextView
                        android:id="@+id/weakest_name"
                        style="@style/Text.Title.Row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        tools:text="Rights &amp; Responsibilities" />

                    <TextView
                        android:id="@+id/weakest_accuracy"
                        style="@style/Text.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        tools:text="50% accuracy" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/md_outline" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
