<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="@dimen/screen_pad_h"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:padding="13dp"
            android:src="@drawable/ic_arrow_left"
            app:tint="@color/md_on_surface" />

        <TextView
            style="@style/Text.Title.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:text="@string/settings_title" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_pad_h"
        android:paddingEnd="@dimen/screen_pad_h"
        android:paddingBottom="@dimen/screen_pad_bottom">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Appearance -->
            <TextView
                style="@style/Text.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/set_appearance" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_segment_track"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/theme_system"
                    style="@style/Text.Title.Row"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="@dimen/touch_min"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="@string/set_theme_system" />

                <TextView
                    android:id="@+id/theme_light"
                    style="@style/Text.Title.Row"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="@dimen/touch_min"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="@string/set_theme_light" />

                <TextView
                    android:id="@+id/theme_dark"
                    style="@style/Text.Title.Row"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="@dimen/touch_min"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="@string/set_theme_dark" />
            </LinearLayout>

            <!-- Study -->
            <TextView
                style="@style/Text.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/set_study" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Bordered"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/pad_card">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Title.Row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/set_goal_title" />

                        <TextView
                            style="@style/Text.Meta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/set_goal_sub" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/goal_10"
                        style="@style/Text.Title.Row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_choice"
                        android:clickable="true"
                        android:focusable="true"
                        android:minWidth="44dp"
                        android:gravity="center"
                        android:paddingStart="15dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="15dp"
                        android:paddingBottom="9dp"
                        android:text="10"
                        android:textSize="13.5sp" />

                    <TextView
                        android:id="@+id/goal_20"
                        style="@style/Text.Title.Row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_chip_choice"
                        android:clickable="true"
                        android:focusable="true"
                        android:minWidth="44dp"
                        android:gravity="center"
                        android:paddingStart="15dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="15dp"
                        android:paddingBottom="9dp"
                        android:text="20"
                        android:textSize="13.5sp" />

                    <TextView
                        android:id="@+id/goal_30"
                        style="@style/Text.Title.Row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_chip_choice"
                        android:clickable="true"
                        android:focusable="true"
                        android:minWidth="44dp"
                        android:gravity="center"
                        android:paddingStart="15dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="15dp"
                        android:paddingBottom="9dp"
                        android:text="30"
                        android:textSize="13.5sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/test_date_row"
                style="@style/Card.Bordered"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_list"
                android:clickable="true"
                android:focusable="true">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/pad_card">

                    <TextView
                        android:id="@+id/title"
                        style="@style/Text.Title.Row"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/set_test_date"
                        app:layout_constraintEnd_toStartOf="@id/test_date_chevron"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/subtitle"
                        style="@style/Text.Meta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        app:layout_constraintEnd_toStartOf="@id/test_date_chevron"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/title"
                        tools:text="Not set" />

                    <ImageView
                        android:id="@+id/test_date_chevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/md_outline" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Reminders -->
            <TextView
                style="@style/Text.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/set_reminders" />

            <LinearLayout
                android:id="@+id/reminders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <!-- Data -->
            <TextView
                style="@style/Text.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/set_data" />

            <LinearLayout
                android:id="@+id/data_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_grouped_list"
                android:orientation="vertical" />

            <!-- About -->
            <TextView
                style="@style/Text.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/set_about" />

            <LinearLayout
                android:id="@+id/about_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_grouped_list"
                android:orientation="vertical" />

            <TextView
                style="@style/Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:lineSpacingMultiplier="1.5"
                android:text="@string/set_disclaimer"
                android:textColor="@color/md_text_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
