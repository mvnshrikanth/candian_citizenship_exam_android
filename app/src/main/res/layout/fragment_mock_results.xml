<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_pad_h"
        android:paddingTop="@dimen/pad_card"
        android:paddingEnd="@dimen/screen_pad_h"
        android:paddingBottom="@dimen/pad_card">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/pad_card_xl">

                    <FrameLayout
                        android:id="@+id/banner_disc"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_result_disc">

                        <ImageView
                            android:id="@+id/banner_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_check" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/banner_headline"
                        style="@style/Text.Headline.Weak"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/pad_card"
                        tools:text="You would have passed" />

                    <TextView
                        android:id="@+id/banner_note"
                        style="@style/Text.Body.Loose"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        tools:text="Fifteen correct is the passing mark." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pad_card"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/score"
                    style="@style/Text.Display.Score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="17" />

                <TextView
                    android:id="@+id/score_of"
                    style="@style/Text.Cta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/md_on_surface_variant"
                    tools:text="of 20 · 85%" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pad_card"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/stat_correct"
                            style="@style/Text.Stat.M"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/md_on_secondary_container"
                            tools:text="17" />

                        <TextView
                            style="@style/Text.Meta.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mock_stat_correct" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_list_wide"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/stat_wrong"
                            style="@style/Text.Stat.M"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/md_error"
                            tools:text="3" />

                        <TextView
                            style="@style/Text.Meta.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mock_stat_wrong" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_list_wide"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/stat_time"
                            style="@style/Text.Stat.M"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="21m" />

                        <TextView
                            android:id="@+id/stat_time_label"
                            style="@style/Text.Meta.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="of 30" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_pad_h"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/screen_pad_h"
        android:paddingBottom="@dimen/screen_pad_bottom">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/review_all"
            style="@style/Button.Cta.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Review all 20 answers" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_list"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/practise_weak"
                style="@style/Button.Cta.Neutral"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/gap_list"
                android:layout_weight="1"
                android:text="@string/mock_practise_weak" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retake"
                style="@style/Button.Cta.Neutral"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mock_retake" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back_home"
            style="@style/Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/results_back_home" />
    </LinearLayout>
</LinearLayout>
