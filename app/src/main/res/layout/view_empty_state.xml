<?xml version="1.0" encoding="utf-8"?>
<!-- The design's one empty state: a tinted disc, a serif line, a short paragraph and a
     single way out. Shared by the weak list, bookmarks and search. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/empty_state"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="48dp"
    android:paddingEnd="32dp"
    android:paddingBottom="32dp">

    <FrameLayout
        android:id="@+id/empty_disc"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_result_disc">

        <ImageView
            android:id="@+id/empty_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            tools:src="@drawable/ic_check" />
    </FrameLayout>

    <TextView
        android:id="@+id/empty_title"
        style="@style/Text.Headline.Empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pad_card"
        tools:text="Nothing to review" />

    <TextView
        android:id="@+id/empty_body"
        style="@style/Text.Body.Loose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_horizontal"
        android:textColor="@color/md_on_surface_variant"
        tools:text="Questions land here after you miss them twice." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/empty_cta"
        style="@style/Button.Cta.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pad_card_xl"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        tools:text="Quick practice" />
</LinearLayout>
