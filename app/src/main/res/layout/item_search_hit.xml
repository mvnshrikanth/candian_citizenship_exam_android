<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Card.Bordered"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/pad_card_row"
        android:paddingTop="@dimen/pad_card_row"
        android:paddingEnd="4dp"
        android:paddingBottom="@dimen/pad_card_row">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/topic"
                style="@style/Text.Meta.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Rights &amp; Responsibilities" />

            <TextView
                android:id="@+id/question"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="Through Habeas Corpus, a person can challenge unlawful detention." />

            <TextView
                android:id="@+id/answer"
                style="@style/Text.Body.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontVariationSettings="'wght' 600"
                android:textColor="@color/md_on_secondary_container"
                tools:text="English Common Law" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/flag"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_flag_outline"
            app:tint="@color/md_outline" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
